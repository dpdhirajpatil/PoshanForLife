<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Poshan</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UILaunchScreen</key>
	<dict/>

	<!-- Required by App Store review for any camera-access request (IOS-10's
	     InBody report capture, IOS-13's pre-call self-preview). Same string
	     in both configs, so it lives in each plist directly rather than as
	     an INFOPLIST_KEY_* xcconfig setting — this target ships hand-written
	     plists, not a generated one, so INFOPLIST_KEY_* build settings never
	     get merged in. -->
	<key>NSCameraUsageDescription</key>
	<string>Poshan for Life uses your camera to capture InBody report photos and for video consultations.</string>

	<!-- IOS-13: microphone access for the pre-call screen — the scaffold
	     around a video call, not a working one yet, but the permission ask
	     is real. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Poshan for Life uses your microphone during video consultations.</string>

	<!-- IOS-11: read-only HealthKit sync (steps, sleep, heart rate, weight).
	     NSHealthUpdateUsageDescription is included even though this app only
	     requests read access today — the write-back path (manual Track logs
	     also writing into Apple Health) is an explicitly optional nice-to-have
	     noted in the prompt, and adding the string now avoids a resubmission
	     just to enable it later. -->
	<key>NSHealthShareUsageDescription</key>
	<string>Poshan for Life reads your steps, sleep, heart rate, and weight from Apple Health to keep your tracking up to date automatically.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Poshan for Life may write logs you enter manually back to Apple Health so your other health apps can see them.</string>

	<!-- Lets a data-only (silent) push wake the app briefly to process it before
	     the user ever taps a banner — without this, `didReceiveRemoteNotification`
	     never fires while the app is backgrounded/suspended. `fetch` is IOS-11's
	     BGAppRefreshTask HealthKit sync. Both Debug and Release need this array;
	     it's not part of the Debug/Release ATS-style split. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>

	<!-- IOS-11: lets HealthKitBackgroundSync register/submit its BGAppRefreshTask.
	     Every identifier BGTaskScheduler is asked to register or submit must be
	     listed here, or both calls fail silently. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.poshanforlife.ios.healthkit-sync</string>
	</array>

	<!-- Debug only. Fed by DEV_LAN_HOST in Debug.xcconfig; read by BaseURL.swift
	     when running on a physical device. Absent from Info-Release.plist. -->
	<key>DevLANHost</key>
	<string>$(DEV_LAN_HOST)</string>

	<!-- Debug only: reach the local Spring Boot backend over cleartext HTTP.
	     Scoped rather than blanket — NSAllowsArbitraryLoads would open every
	     host on the internet, which is far more than a dev backend needs.
	     NSAllowsLocalNetworking covers the private-range LAN IP used on a
	     physical device; the explicit localhost exception covers the Simulator,
	     which resolves to loopback rather than a local-network address.
	     This mirrors android/app/src/debug/res/xml/network_security_config.xml,
	     which whitelists exactly 10.0.2.2 and localhost. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
