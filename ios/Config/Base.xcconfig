// Settings shared by every build configuration.

PRODUCT_NAME = PoshanForLife
PRODUCT_BUNDLE_IDENTIFIER = com.poshanforlife.ios
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 16.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 5.0

// Portrait only, matching the Android app — none of the screens have a
// landscape layout and half-built rotation support reads as a bug.
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait

ENABLE_USER_SCRIPT_SANDBOXING = YES
