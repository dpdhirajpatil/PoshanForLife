# Copy to .env (or export in your shell / deployment environment).
# The `local` profile has safe defaults for everything except real integrations.

# Active Spring profile: local | dev | prod (defaults to local)
SPRING_PROFILES_ACTIVE=local

# PostgreSQL (Supabase connection string works here)
# Note: use a database dedicated to this rebuild (the plain `poshan` DB may
# hold the original Next.js app's Prisma schema — keep Flyway out of it).
DB_URL=jdbc:postgresql://localhost:5432/poshan_api
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT — HS256 secret, minimum 32 bytes
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=1209600000

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Supabase Storage
SUPABASE_STORAGE_URL=
SUPABASE_SERVICE_KEY=

# Anthropic (report OCR / analysis)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
