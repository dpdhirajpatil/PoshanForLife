# Copy to .env (or export in your shell / deployment environment).
# The `local` profile has safe defaults for everything except real integrations.

# Active Spring profile: local | dev | prod (defaults to local)
SPRING_PROFILES_ACTIVE=local

# PostgreSQL (Supabase connection string works here)
# Note: use a database dedicated to this rebuild (the plain `poshan` DB may
# hold the original Next.js app's Prisma schema — keep Flyway out of it).
DB_URL=jdbc:postgresql://localhost:5432/poshan_api
DB_USERNAME=postgres
DB_PASSWORD=postgres

# One-time bootstrap only — NOT a normal part of local dev. Set these two only
# for the first startup against a database where V1-V16 were already applied
# by hand (e.g. a manual SQL script run in Supabase's SQL Editor), so Flyway
# baselines instead of trying to replay migrations against existing tables.
# Unset both again after that first successful startup.
# SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
# SPRING_FLYWAY_BASELINE_VERSION=16

# JWT — HS256 secret, minimum 32 bytes
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=1209600000

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Supabase Storage — the storage API base: <project-url>/storage/v1.
# Server-side only: use the service_role key, never expose it to the frontend.
SUPABASE_STORAGE_URL=https://your-project-ref.supabase.co/storage/v1
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=programme-covers
# Private bucket for report/InBody PDFs — do NOT make this one public.
SUPABASE_REPORTS_BUCKET=poshan-reports

# Anthropic (report OCR / analysis)
ANTHROPIC_API_KEY=sk-ant-api03-your-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Firebase Admin SDK (FCM push). Download a service account key from the
# Firebase console (Project settings > Service accounts) and point at it here
# — never commit the JSON file itself. Alternatively set FIREBASE_CREDENTIALS_BASE64
# (base64 of the whole JSON) for deployments where a file path isn't convenient.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
FIREBASE_CREDENTIALS_BASE64=

# --- MSG91 (phone-number OTP login/signup) -----------------------------------
# Transactional SMS provider. The auth key is a secret — never commit the real
# value. template-id and sender-id must both be DLT-approved by MSG91 before
# real sends work in India; that approval is paperwork measured in days, so
# start it early. Leave these blank for local work: the local/dev Spring
# profiles skip the SMS send entirely and accept the fixed code 000000
# (hard-disabled under the prod profile — see PhoneOtpService).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=POSHAN
MSG91_BASE_URL=
