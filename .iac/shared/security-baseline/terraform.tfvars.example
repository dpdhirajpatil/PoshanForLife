aws_region = "ap-south-1"

# Multi-account: the account this config must deploy into (Terraform aborts
# on any other). Set aws_profile when this env lives in a separate account.
allowed_account_ids = ["<account-id>"]
# aws_profile       = "poshan-dev"

# Flip on once the account can subscribe to GuardDuty.
enable_guardduty = false

# Monthly cost alert; leave unset for no budget.
# budget_alert_email = "you@example.com"
# monthly_budget_usd = 25
